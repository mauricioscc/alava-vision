# Copie este arquivo para .env e ajuste os valores.
ADMIN_PASSWORD=troque-esta-senha
# Porta do servidor/painel. Usada por iniciar_alava_vision.bat, iniciar_servidor.bat e player.py.
# Troque se a 8080 já estiver em uso no computador (ex.: 8090).
PORT=8080

# Localização para clima e trânsito (latitude/longitude)
WEATHER_LAT=-22.9068
WEATHER_LON=-43.1729
WEATHER_CITY=Rio de Janeiro
# Código IBGE do município (alertas do INMET)
IBGE_CODE=3304557

# Google Maps Embed API Key (opcional - para widget de trânsito)
MAPS_API_KEY=

# Monitor da TV para o player: 1 = principal, 2 = segundo monitor (padrão), 3 = terceiro...
PLAYER_MONITOR=2
